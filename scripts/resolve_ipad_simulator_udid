#!/usr/bin/env bash
#
# Prints the UDID of the best available iPad simulator on the newest
# installed iOS runtime, for use in an xcodebuild `-destination`.
# Priority: iPad Pro > iPad Air > other iPad devices.
#
# Usage:
#   SIMULATOR_UDID=$(scripts/resolve_ipad_simulator_udid)
#   xcodebuild ... -destination "platform=iOS Simulator,id=$SIMULATOR_UDID"
#

set -euo pipefail

if ! devices_json=$(xcrun simctl list devices available -j 2>&1); then
    echo "error: \`xcrun simctl\` failed:" >&2
    echo "$devices_json" >&2
    echo "If it reports a missing developer directory, point xcode-select at a full" >&2
    echo "Xcode install: sudo xcode-select -s /Applications/Xcode.app" >&2
    exit 1
fi

result=$(printf '%s' "$devices_json" | python3 -c '
import json, re, sys

try:
    data = json.load(sys.stdin)
    devices = data.get("devices", {})
except (json.JSONDecodeError, KeyError, TypeError) as error:
    sys.exit("error: could not parse the device list from xcrun simctl: " + str(error))

def ios_version(runtime):
    match = re.search(r"iOS-(\d+)-(\d+)", runtime)
    return (int(match.group(1)), int(match.group(2))) if match else (0, 0)

selected_device = None
selected_runtime = None

for runtime in sorted(devices.keys(), key=ios_version, reverse=True):
    if not re.search(r"iOS-\d+-\d+", runtime):
        continue
    ipads = [d for d in devices[runtime] if "iPad" in d.get("name", "") and d.get("isAvailable", True)]
    if not ipads:
        continue

    def priority(d):
        name = d.get("name", "")
        # Prefer standard full-screen iPad devices (iPad 10th/9th gen) to avoid Stage Manager windowing stalls
        if "iPad (" in name:
            return 0
        if "iPad Air" in name:
            return 1
        if "iPad Pro" in name:
            return 2
        return 3

    ipads.sort(key=priority)
    selected_device = ipads[0]
    selected_runtime = runtime
    break

if selected_device:
    name = selected_device.get("name", "iPad")
    udid = selected_device.get("udid", "")
    print(f"SELECTED_INFO: {name} on {selected_runtime} ({udid})", file=sys.stderr)
    print(udid)
else:
    sys.exit("NO_IPAD_FOUND")
')

if [ -z "$result" ]; then
    echo "error: no available iPad simulator on any installed iOS runtime." >&2
    echo "Available runtimes and devices:" >&2
    xcrun simctl list devices available >&2
    exit 1
fi

printf '%s\n' "$result"
